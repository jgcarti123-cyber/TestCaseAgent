# Proprietary TML source data - not tracked in this repo (see Docs/architecture.md
# for the full folder map; these directories exist locally but stay out of version
# control on purpose - CAN bit-level specs, requirement docs, and test case data
# are confidential).
/Signal_Catalogs/
/Requirement_Docs/
/Existing_TestCases/
/Generated_TestCases/
/Traceability/

# macOS / Excel artifacts
.DS_Store
~$*.xlsx

# Credentials - defensive, even though no script currently reads from a
# .env file (Jira/Xray creds are read from real environment variables
# only, per Scripts/*.py docstrings). Covers it if that ever changes.
.env
.env.*
*.pem
*.key
